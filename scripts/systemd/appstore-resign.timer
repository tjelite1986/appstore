[Unit]
Description=Run appstore-resign every 5 minutes

[Timer]
# Short, because a build of a store-signed listing cannot be downloaded until
# it has been signed. A run with nothing to do is one HTTP call.
OnBootSec=6min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
