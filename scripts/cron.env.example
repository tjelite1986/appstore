# Copy to cron.env beside this file and fill in. Not in the repository: both
# values say where one machine keeps things, not how the store works.
#
# APPSTORE_URL   the base URL the store answers on
# APPSTORE_ENV   the compose env file holding STORE_ADMIN_TOKEN

APPSTORE_URL=https://store.example.com
APPSTORE_ENV=/srv/compose/appstore/.env
