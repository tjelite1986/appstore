# Copy to cron.env beside this file and fill in. Not in the repository: every
# value here says where one machine keeps things, not how the store works.
#
# APPSTORE_URL         the base URL the store answers on, including the
#                      path prefix if it is mounted under one
# APPSTORE_ENV         the compose env file holding STORE_ADMIN_TOKEN
# APPSTORE_STORE_ROOT  the library as the host sees it — the source side of
#                      the bind mount that is STORE_ROOT in the container.
#                      Only fdroid-sign.sh needs it, because only it holds a
#                      key and writes a file the app then serves.

APPSTORE_URL=https://store.example.com
APPSTORE_ENV=/srv/compose/appstore/.env
APPSTORE_STORE_ROOT=/srv/appstore
