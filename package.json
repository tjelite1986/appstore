{
  "name": "appstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "next lint",
    "rebuild:native": "docker run --rm -u 0 -v \"$PWD\":/app -w /app node:20-slim bash -c \"apt-get update -qq && apt-get install -y -qq python3 make g++ && npm rebuild better-sqlite3 --build-from-source && chown -R 1000:1003 node_modules/better-sqlite3\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "google-play-scraper": "^10.1.3",
    "lucide-react": "^0.577.0",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^2.4.0",
    "teleproto": "^1.228.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
